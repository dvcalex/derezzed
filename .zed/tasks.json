[
  {
    "label": "Configure",
    "command": "cmake --preset default",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "on_success",
  },
  {
    "label": "Build",
    "command": "cmake --build --preset default",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "Build (verbose)",
    "command": "cmake --build --preset default --verbose",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "never",
  },
  {
    "label": "Clean",
    "command": "cmake --build --preset default --target clean",
    "cwd": "${ZED_WORKTREE_ROOT}",
    "reveal": "always",
    "hide": "on_success",
  },
]
